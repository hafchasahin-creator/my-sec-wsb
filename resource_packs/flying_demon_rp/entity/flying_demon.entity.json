        "dive": "animation.fdc_demon.dive",
        "sit": "animation.fdc_demon.sit",
        "land": "animation.fdc_demon.land",
        "rage_enter": "animation.fdc_demon.rage_enter",
        "bite": "animation.fdc_demon.bite",
        "devour": "animation.fdc_demon.devour",
        "firebreath": "animation.fdc_demon.firebreath",
        "ambient_fx": "animation.fdc_demon.ambient_fx",
