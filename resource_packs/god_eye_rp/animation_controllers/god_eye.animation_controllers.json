{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.god_eye.state": {
      "initial_state": "spawn",
      "states": {
        "spawn": {
          "animations": ["spawn", "float", "aura_emit"],
          "transitions": [
            { "idle": "query.any_animation_finished" }
          ]
        },

        "idle": {
          "blend_transition": 0.45,
          "animations": ["float", "look", "aura_emit"],
          "transitions": [
            { "shy": "query.mark_variant == 1" },
            { "alert": "query.mark_variant == 2" },
            { "execute": "query.mark_variant == 3" }
          ]
        },

        "shy": {
          "blend_transition": 0.8,
          "animations": ["float", "shy", "aura_emit"],
          "transitions": [
            { "alert": "query.mark_variant == 2" },
            { "execute": "query.mark_variant == 3" },
            { "idle": "query.mark_variant == 0" }
          ]
        },

        "alert": {
          "blend_transition": 0.25,
          "animations": ["float_fast", "look", "alert", "aura_emit_heavy"],
          "transitions": [
            { "execute": "query.mark_variant == 3" },
            { "shy": "query.mark_variant == 1" },
            { "idle": "query.mark_variant == 0" }
          ]
        },

        "execute": {
          "blend_transition": 0.15,
          "animations": ["float_fast", "look", "execute", "aura_emit_heavy"],
          "transitions": [
            { "alert": "query.mark_variant == 2" },
            { "shy": "query.mark_variant == 1" },
            { "idle": "query.mark_variant == 0" }
          ]
        }
      }
    },

    "controller.animation.god_eye.swarm": {
      "initial_state": "spawn",
      "states": {
        "spawn": {
          "animations": ["spawn", "swarm_float"],
          "transitions": [
            { "hunt": "query.any_animation_finished" }
          ]
        },
        "hunt": {
          "blend_transition": 0.2,
          "animations": ["swarm_float", "aura_emit"]
        }
      }
    }
  }
}
