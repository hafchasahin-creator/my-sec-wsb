{
  "format_version": "1.8.0",
  "animations": {
    "animation.god_eye.float": {
      "loop": true,
      "animation_length": 6.0,
      "bones": {
        "body": {
          "position": [
            "math.cos(query.life_time * 37) * 0.7",
            "math.sin(query.life_time * 55) * 1.5",
            "math.sin(query.life_time * 29) * 0.7"
          ]
        },
        "eyeball": {
          "rotation": [
            "math.sin(query.life_time * 23) * 5",
            "math.mod(query.life_time * 11, 360)",
            "math.cos(query.life_time * 19) * 5"
          ]
        },
        "aura": {
          "rotation": [
            "math.sin(query.life_time * 17) * 8",
            "math.mod(query.life_time * -19, 360)",
            0
          ],
          "scale": ["1.0 + math.sin(query.life_time * 41) * 0.06", 1.0, "1.0 + math.sin(query.life_time * 41) * 0.06"]
        }
      }
    },

    "animation.god_eye.float_fast": {
      "loop": true,
      "animation_length": 3.0,
      "bones": {
        "body": {
          "position": [
            "math.cos(query.life_time * 90) * 0.9",
            "math.sin(query.life_time * 130) * 1.2",
            "math.sin(query.life_time * 70) * 0.9"
          ]
        },
        "eyeball": {
          "rotation": [
            "math.sin(query.life_time * 60) * 7",
            "math.mod(query.life_time * 46, 360)",
            "math.cos(query.life_time * 52) * 7"
          ]
        },
        "aura": {
          "rotation": [
            "math.sin(query.life_time * 44) * 12",
            "math.mod(query.life_time * -78, 360)",
            0
          ],
          "scale": ["1.0 + math.sin(query.life_time * 150) * 0.1", 1.0, "1.0 + math.sin(query.life_time * 150) * 0.1"]
        }
      }
    },

    "animation.god_eye.look": {
      "loop": true,
      "animation_length": 1.0,
      "bones": {
        "head": {
          "rotation": [
            "math.clamp(query.target_x_rotation, -28, 28)",
            "math.clamp(query.target_y_rotation, -32, 32)",
            0
          ]
        }
      }
    },

    "animation.god_eye.shy": {
      "loop": true,
      "animation_length": 2.0,
      "bones": {
        "body": {
          "rotation": [0, 36, 0]
        },
        "pupil": {
          "scale": [0.42, 0.42, 1.0]
        },
        "glow": {
          "scale": [0.8, 0.8, 1.0]
        }
      }
    },

    "animation.god_eye.alert": {
      "loop": true,
      "animation_length": 1.0,
      "bones": {
        "pupil": {
          "scale": [1.35, 1.35, 1.0]
        },
        "glow": {
          "scale": [1.25, 1.25, 1.0]
        },
        "aura": {
          "scale": [1.25, 1.25, 1.25]
        }
      }
    },

    "animation.god_eye.execute": {
      "loop": true,
      "animation_length": 1.0,
      "bones": {
        "body": {
          "position": [
            "math.random(-0.4, 0.4)",
            "math.random(-0.4, 0.4)",
            -1.5
          ]
        },
        "pupil": {
          "scale": [1.75, 1.75, 1.0]
        },
        "glow": {
          "scale": [1.55, 1.55, 1.0]
        },
        "aura": {
          "scale": [1.55, 1.55, 1.55]
        }
      }
    },

    "animation.god_eye.spawn": {
      "loop": false,
      "animation_length": 0.9,
      "bones": {
        "root": {
          "scale": {
            "0.0": 0.0,
            "0.4": 1.3,
            "0.9": 1.0
          }
        }
      },
      "particle_effects": {
        "0.0": { "effect": "blink", "locator": "aura" }
      }
    },

    "animation.god_eye.aura_emit": {
      "loop": true,
      "animation_length": 1.2,
      "particle_effects": {
        "0.0": { "effect": "aura", "locator": "aura" }
      }
    },

    "animation.god_eye.aura_emit_heavy": {
      "loop": true,
      "animation_length": 0.4,
      "particle_effects": {
        "0.0": { "effect": "aura", "locator": "aura" },
        "0.2": { "effect": "wisp", "locator": "pupil" }
      }
    },

    "animation.god_eye.swarm_float": {
      "loop": true,
      "animation_length": 2.0,
      "bones": {
        "body": {
          "position": [0, "math.sin(query.life_time * 210) * 1.6", 0]
        },
        "eyeball": {
          "rotation": [0, "math.mod(query.life_time * 90, 360)", 0]
        },
        "aura": {
          "scale": [0.4, 0.4, 0.4]
        },
        "head": {
          "rotation": [
            "math.clamp(query.target_x_rotation, -30, 30)",
            "math.clamp(query.target_y_rotation, -34, 34)",
            0
          ]
        }
      }
    }
  }
}
