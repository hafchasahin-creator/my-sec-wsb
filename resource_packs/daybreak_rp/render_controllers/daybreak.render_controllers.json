{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.daybreak.default": {
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.default" }],
      "textures": ["Texture.default"]
    },

    "controller.render.daybreak.mimic": {
      "arrays": {
        "textures": {
          "Array.skins": ["Texture.default", "Texture.revealed"]
        },
        "geometries": {
          "Array.shapes": ["Geometry.default", "Geometry.revealed"]
        }
      },
      "geometry": "Array.shapes[query.variant]",
      "materials": [{ "*": "Material.default" }],
      "textures": ["Array.skins[query.variant]"]
    },

    "controller.render.daybreak.armor": {
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.default" }],
      "textures": ["Texture.default"]
    }
  }
}
