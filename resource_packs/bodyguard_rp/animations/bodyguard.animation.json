{
  "format_version": "1.8.0",
  "animations": {
    "animation.bodyguard.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "relative_to": {
            "rotation": "entity"
          },
          "rotation": ["query.target_x_rotation", "query.target_y_rotation", 0.0]
        }
      }
    },

    "animation.bodyguard.layers": {
      "loop": true,
      "bones": {
        "hat": { "scale": "variable.helmet_layer_visible" },
        "visor": { "scale": "variable.helmet_layer_visible" },
        "earpiece": { "scale": "variable.helmet_layer_visible" },
        "pauldronRight": { "scale": "variable.chest_layer_visible" },
        "pauldronLeft": { "scale": "variable.chest_layer_visible" },
        "insignia": { "scale": "variable.chest_layer_visible * (query.skin_id > 0 ? 1.0 : 0.0)" }
      }
    },

    "animation.bodyguard.holding": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": ["variable.is_holding_right ? (-this * 0.5 - 22.0) : 0.0", 0.0, 0.0]
        },
        "leftArm": {
          "rotation": ["variable.is_holding_left ? (-this * 0.5 - 18.0) : 0.0", 0.0, 0.0]
        }
      }
    },

    "animation.bodyguard.hurt": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": ["-query.hurt_time * 1.1", "query.hurt_time * 1.6", "query.hurt_time * 0.8"]
        },
        "head": {
          "rotation": ["-query.hurt_time * 1.0", 0.0, "query.hurt_time * 1.2"]
        },
        "rightArm": { "rotation": ["query.hurt_time * 2.2", 0.0, 0.0] },
        "leftArm": { "rotation": ["query.hurt_time * 2.2", 0.0, 0.0] }
      }
    },

    "animation.bodyguard.idle": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [0.0, "math.sin(query.life_time * 40.0) * 0.9", 0.0],
          "position": [0.0, "math.sin(query.life_time * 80.0) * 0.14", 0.0]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time * 55.0) * 1.4",
            "math.sin(query.life_time * 21.0) * 5.0",
            "math.sin(query.life_time * 33.0) * 0.8"
          ]
        },
        "rightArm": {
          "rotation": [
            "math.sin(query.life_time * 40.0) * 1.6 - 3.0",
            0.0,
            "2.5 + math.sin(query.life_time * 31.0) * 1.1"
          ]
        },
        "leftArm": {
          "rotation": [
            "math.sin(query.life_time * 40.0 + 110.0) * 1.6 - 3.0",
            0.0,
            "-2.5 - math.sin(query.life_time * 31.0) * 1.1"
          ]
        }
      }
    },

    "animation.bodyguard.idle_alert": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [3.0, "math.sin(query.life_time * 130.0) * 2.2", 0.0],
          "position": [0.0, "math.sin(query.life_time * 260.0) * 0.1", 0.0]
        },
        "head": { "rotation": [-2.0, "math.sin(query.life_time * 90.0) * 2.5", 0.0] },
        "rightArm": {
          "rotation": ["-36.0 + math.sin(query.life_time * 130.0) * 3.2", -12.0, -15.0]
        },
        "leftArm": {
          "rotation": ["-20.0 + math.sin(query.life_time * 130.0 + 60.0) * 3.2", 14.0, 17.0]
        },
        "rightLeg": { "rotation": [-9.0, -4.0, -2.0] },
        "leftLeg": { "rotation": [9.0, 4.0, 2.0] }
      }
    },

    "animation.bodyguard.at_ease": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [-1.0, "math.sin(query.life_time * 26.0) * 1.3", 0.0]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time * 34.0) * 1.6",
            "math.sin(query.life_time * 13.0) * 11.0",
            0.0
          ]
        },
        "rightArm": { "rotation": [13.0, -2.0, -15.0] },
        "leftArm": { "rotation": [13.0, 2.0, 15.0] },
        "rightLeg": { "rotation": [0.0, -7.0, -3.0] },
        "leftLeg": { "rotation": [0.0, 7.0, 3.0] }
      }
    },

    "animation.bodyguard.walk": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [2.0, "math.cos(query.modified_distance_moved * 38.17) * 2.2", 0.0],
          "position": [0.0, "math.abs(math.sin(query.modified_distance_moved * 38.17)) * 0.35", 0.0]
        },
        "rightArm": { "rotation": ["-variable.tcos0 * 0.9", 0.0, 2.0] },
        "leftArm": { "rotation": ["variable.tcos0 * 0.9", 0.0, -2.0] },
        "rightLeg": { "rotation": ["variable.tcos0 * 1.35", 0.1, 0.1] },
        "leftLeg": { "rotation": ["-variable.tcos0 * 1.35", -0.1, -0.1] }
      }
    },

    "animation.bodyguard.run": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [11.0, "math.cos(query.modified_distance_moved * 38.17) * 3.4", 0.0],
          "position": [0.0, "math.abs(math.sin(query.modified_distance_moved * 38.17)) * 0.6", 0.0]
        },
        "head": { "rotation": [-9.0, 0.0, 0.0] },
        "rightArm": { "rotation": ["-variable.tcos0 * 1.15 - 24.0", 0.0, 7.0] },
        "leftArm": { "rotation": ["variable.tcos0 * 1.15 - 24.0", 0.0, -7.0] },
        "rightLeg": { "rotation": ["variable.tcos0 * 1.75", 0.1, 0.1] },
        "leftLeg": { "rotation": ["-variable.tcos0 * 1.75", -0.1, -0.1] }
      }
    },

