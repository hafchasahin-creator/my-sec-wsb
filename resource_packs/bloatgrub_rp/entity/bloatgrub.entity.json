{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "grub:bloatgrub",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/bloatgrub"
      },
      "geometry": {
        "default": "geometry.bloatgrub"
      },
      "animations": {
        "idle": "animation.bloatgrub.idle",
        "walk": "animation.bloatgrub.walk",
        "pounce": "animation.bloatgrub.pounce"
      },
      "scripts": {
        "animate": [
          "idle",
          {
            "walk": "query.modified_move_speed"
          },
          {
            "pounce": "1 - query.is_on_ground"
          }
        ]
      },
      "render_controllers": [
        "controller.render.bloatgrub"
      ],
      "spawn_egg": {
        "base_color": "#b9a79d",
        "overlay_color": "#5d1418"
      }
    }
  }
}
