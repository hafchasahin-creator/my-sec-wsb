{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "tp:parasite",
      "is_spawnable": true,
      "is_summonable": true
    },

    "component_groups": {
      "tp:dormant": {
        "minecraft:timer": {
          "looping": false,
          "time": 2.0,
          "time_down_event": {
            "event": "tp:wake_event"
          }
        },
        "minecraft:movement": {
          "value": 0.12
        }
      },

      "tp:hunting": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": true,
          "must_see_forget_duration": 12.0,
          "reselect_targets": true,
          "scan_interval": 8,
          "within_radius": 16.0,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "mob"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "parasite"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "inanimate"
                  }
                ]
              },
              "max_dist": 16,
              "must_see": true
            },
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 16,
              "must_see": true
            }
          ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 2,
          "speed_multiplier": 1.5,
          "track_target": true,
          "reach_multiplier": 1.4,
          "attack_once": false
        }
      },

      "tp:pose_normal": {
        "minecraft:variant": {
          "value": 0
        }
      },
      "tp:pose_lunge": {
        "minecraft:variant": {
          "value": 1
        }
      },
      "tp:pose_burrow": {
        "minecraft:variant": {
          "value": 2
        }
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": [
          "parasite",
          "tp_parasite",
          "monster",
          "mob"
        ]
      },

      "minecraft:collision_box": {
        "width": 0.5,
        "height": 0.42
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:breathable": {
        "total_supply": 20,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:can_climb": {},
      "minecraft:jump.static": {
        "jump_power": 0.42
      },
      "minecraft:movement": {
        "value": 0.32
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_sink": false,
        "can_float": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "can_pass_doors": true,
        "can_open_doors": false
      },

      "minecraft:health": {
        "value": 6,
        "max": 6
      },
      "minecraft:attack": {
        "damage": 1
      },
      "minecraft:follow_range": {
        "value": 20,
        "max": 24
      },
      "minecraft:knockback_resistance": {
        "value": 0.0
      },
      "minecraft:scale": {
        "value": 1.0
      },
      "minecraft:nameable": {
        "always_show": false,
        "allow_name_tag_renaming": true
      },

      "minecraft:loot": {
        "table": "loot_tables/entities/parasite.json"
      },

      "minecraft:despawn": {
        "despawn_from_distance": {
          "max_distance": 96,
          "min_distance": 54
        }
      },

      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": false
          },
          {
            "cause": "fire",
            "damage_multiplier": 3.0
          },
          {
            "cause": "fire_tick",
            "damage_multiplier": 3.0
          },
          {
            "cause": "lava",
            "damage_multiplier": 3.0
          }
        ]
      },

      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 3,
        "alert_same_type": true
      },
      "minecraft:behavior.random_stroll": {
        "priority": 5,
        "speed_multiplier": 0.9,
        "xz_dist": 8,
        "interval": 60
      },
      "minecraft:behavior.look_at_player": {
        "priority": 6,
        "look_distance": 8.0,
        "probability": 0.6
      },
      "minecraft:behavior.random_look_around": {
        "priority": 7,
        "look_distance": 6.0
      }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "tp:hunting",
            "tp:pose_normal"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add tp_parasite",
            "scriptevent tp:spawned parasite"
          ]
        }
      },

      "tp:born_event": {
        "add": {
          "component_groups": [
            "tp:dormant",
            "tp:pose_normal"
          ]
        },
        "remove": {
          "component_groups": [
            "tp:hunting"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s add tp_parasite",
            "tag @s add tp_dormant"
          ]
        }
      },

      "tp:wake_event": {
        "add": {
          "component_groups": [
            "tp:hunting"
          ]
        },
        "remove": {
          "component_groups": [
            "tp:dormant"
          ]
        },
        "queue_command": {
          "command": [
            "tag @s remove tp_dormant"
          ]
        }
      },

      "tp:pose_normal_event": {
        "add": {
          "component_groups": [
            "tp:pose_normal"
          ]
        },
        "remove": {
          "component_groups": [
            "tp:pose_lunge",
            "tp:pose_burrow"
          ]
        }
      },
      "tp:pose_lunge_event": {
        "add": {
          "component_groups": [
            "tp:pose_lunge"
          ]
        },
        "remove": {
          "component_groups": [
            "tp:pose_normal",
            "tp:pose_burrow"
          ]
        }
      },
      "tp:pose_burrow_event": {
        "add": {
          "component_groups": [
            "tp:pose_burrow"
          ]
        },
        "remove": {
          "component_groups": [
            "tp:pose_normal",
            "tp:pose_lunge"
          ]
        }
      }
    }
  }
}
