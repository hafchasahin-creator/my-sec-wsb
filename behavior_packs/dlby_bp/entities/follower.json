{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "dlby:follower",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "dlby:state_frozen": {
        "minecraft:mark_variant": { "value": 1 },
        "minecraft:movement": { "value": 0.0 }
      },

      "dlby:state_stalk": {
        "minecraft:mark_variant": { "value": 2 },
        "minecraft:movement": { "value": 0.24 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": false,
          "reselect_targets": true,
          "scan_interval": 16,
          "within_radius": 48.0,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "value": "player" },
                  { "test": "has_tag", "subject": "other", "value": "dlby_hunted" }
                ]
              },
              "max_dist": 48
            }
          ]
        },
        "minecraft:behavior.move_towards_target": {
          "priority": 2,
          "speed_multiplier": 1.0,
          "within_radius": 1.5
        }
      },

      "dlby:state_sprint": {
        "minecraft:mark_variant": { "value": 4 },
        "minecraft:movement": { "value": 0.44 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": false,
          "reselect_targets": true,
          "scan_interval": 16,
          "within_radius": 48.0,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "value": "player" },
                  { "test": "has_tag", "subject": "other", "value": "dlby_hunted" }
                ]
              },
              "max_dist": 48
            }
          ]
        },
        "minecraft:behavior.move_towards_target": {
          "priority": 2,
          "speed_multiplier": 1.35,
          "within_radius": 1.5
        }
      },

      "dlby:state_attack": {
        "minecraft:mark_variant": { "value": 3 },
        "minecraft:movement": { "value": 0.0 }
      },

      "dlby:despawn": {
        "minecraft:instant_despawn": {}
      }
    },

    "components": {
      "minecraft:type_family": { "family": ["dlby_follower", "mob"] },
      "minecraft:health": { "value": 60, "max": 60 },
      "minecraft:movement": { "value": 0.0 },
      "minecraft:mark_variant": { "value": 1 },

      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "can_pass_doors": false,
        "can_open_doors": false,
        "can_break_doors": false,
        "can_sink": false
      },

      "minecraft:physics": {},
      "minecraft:collision_box": { "width": 0.6, "height": 2.4 },
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:persistent": {},
      "minecraft:breathable": {
        "breathes_air": true,
        "breathes_water": true,
        "generates_bubbles": false
      },

      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 64,
          "max_dropped_ticks": 10,
          "use_motion_prediction_hints": true
        }
      },

      "minecraft:damage_sensor": {
        "triggers": [
          { "cause": "fall", "deals_damage": false },
          { "cause": "drowning", "deals_damage": false },
          { "cause": "suffocation", "deals_damage": false },
          { "cause": "freezing", "deals_damage": false },
          { "cause": "fire_tick", "deals_damage": false },
          { "cause": "fire", "deals_damage": false }
        ]
      },

      "minecraft:loot": { "table": "loot_tables/entities/follower.json" }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["dlby:state_frozen"] }
      },
      "dlby:freeze": {
        "remove": {
          "component_groups": [
            "dlby:state_stalk",
            "dlby:state_sprint",
            "dlby:state_attack"
          ]
        },
        "add": { "component_groups": ["dlby:state_frozen"] }
      },
      "dlby:stalk": {
        "remove": {
          "component_groups": [
            "dlby:state_frozen",
            "dlby:state_sprint",
            "dlby:state_attack"
          ]
        },
        "add": { "component_groups": ["dlby:state_stalk"] }
      },
      "dlby:sprint": {
        "remove": {
          "component_groups": [
            "dlby:state_frozen",
            "dlby:state_stalk",
            "dlby:state_attack"
          ]
        },
        "add": { "component_groups": ["dlby:state_sprint"] }
      },
      "dlby:attack": {
        "remove": {
          "component_groups": [
            "dlby:state_frozen",
            "dlby:state_stalk",
            "dlby:state_sprint"
          ]
        },
        "add": { "component_groups": ["dlby:state_attack"] }
      },
      "dlby:vanish": {
        "add": { "component_groups": ["dlby:despawn"] }
      }
    }
  }
}
