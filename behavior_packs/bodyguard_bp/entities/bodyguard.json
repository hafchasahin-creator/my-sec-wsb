{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "bodyguard:bodyguard",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "bodyguard:hired": {
        "minecraft:is_tamed": {},
        "minecraft:sittable": {},
        "minecraft:healable": {
          "items": [
            {
              "item": "cooked_beef",
              "heal_amount": 10
            },
            {
              "item": "golden_apple",
              "heal_amount": 20
            }
          ]
        },
        "minecraft:behavior.stay_while_sitting": {
          "priority": 2
        },
        "minecraft:behavior.follow_owner": {
          "priority": 5,
          "speed_multiplier": 1.25,
          "start_distance": 5,
          "stop_distance": 2
        },
        "minecraft:behavior.owner_hurt_by_target": {
          "priority": 1
        },
        "minecraft:behavior.owner_hurt_target": {
          "priority": 2
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 4,
          "must_see": true,
          "must_see_forget_duration": 17,
          "reselect_targets": true,
          "within_radius": 16,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "monster"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "slime"
                  }
                ]
              },
              "max_dist": 16
            }
          ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "entity_attack",
              "deals_damage": false,
              "on_damage": {
                "filters": {
                  "test": "is_owner",
                  "subject": "other",
                  "value": true
                }
              }
            }
          ]
        }
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": [
          "bodyguard",
          "villager",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:health": {
        "value": 40,
        "max": 40
      },
      "minecraft:attack": {
        "damage": 7
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:knockback_resistance": {
        "value": 0.6
      },
      "minecraft:follow_range": {
        "value": 32,
        "max": 32
      },
      "minecraft:nameable": {},
      "minecraft:persistent": {},
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "can_pass_doors": true,
        "can_open_doors": true
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:tameable": {
        "probability": 1.0,
        "tame_items": [
          "minecraft:gold_ingot",
          "minecraft:emerald"
        ],
        "tame_event": {
          "event": "bodyguard:on_hired",
          "target": "self"
        }
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1.25,
        "track_target": true,
        "reach_multiplier": 1.5
      },
      "minecraft:behavior.random_stroll": {
        "priority": 8,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.look_at_player": {
        "priority": 9,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 10
      }
    },

    "events": {
      "bodyguard:on_hired": {
        "add": {
          "component_groups": [
            "bodyguard:hired"
          ]
        }
      }
    }
  }
}
