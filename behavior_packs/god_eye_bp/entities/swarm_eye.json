{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "god_eye:swarm_eye",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "god_eye:despawn": {
        "minecraft:instant_despawn": {}
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": ["god_eye", "guardian_eye"]
      },
      "minecraft:collision_box": {
        "width": 0.35,
        "height": 0.35
      },
      "minecraft:scale": {
        "value": 0.32
      },
      "minecraft:physics": {
        "has_gravity": false,
        "has_collision": false
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:movement": {
        "value": 0.0
      },
      "minecraft:health": {
        "value": 100,
        "max": 100
      },
      "minecraft:knockback_resistance": {
        "value": 1.0,
        "max": 1.0
      },
      "minecraft:fire_immune": true,

      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "suicide",
            "deals_damage": true
          },
          {
            "cause": "self_destruct",
            "deals_damage": true
          },
          {
            "cause": "all",
            "deals_damage": false
          }
        ]
      },

      "minecraft:mark_variant": { "value": 2 },

      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 48.0,
          "max_dropped_ticks": 10,
          "use_motion_prediction_hints": false
        }
      },

      "minecraft:behavior.look_at_entity": {
        "priority": 1,
        "look_distance": 12.0,
        "probability": 1.0,
        "look_time": [1.0, 3.0],
        "angle_of_view_horizontal": 360,
        "angle_of_view_vertical": 360,
        "filters": {
          "any_of": [
            { "test": "is_family", "subject": "other", "value": "monster" },
            { "test": "is_family", "subject": "other", "value": "undead" },
            { "test": "is_family", "subject": "other", "value": "illager" }
          ]
        }
      },

      "minecraft:timer": {
        "looping": false,
        "time": 14.0,
        "time_down_event": {
          "event": "god_eye:vanish"
        }
      }
    },

    "events": {
      "god_eye:vanish": {
        "add": { "component_groups": ["god_eye:despawn"] }
      }
    }
  }
}
