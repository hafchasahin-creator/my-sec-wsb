{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "god_eye:god_eye",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "god_eye:state_idle": {
        "minecraft:mark_variant": { "value": 0 }
      },
      "god_eye:state_shy": {
        "minecraft:mark_variant": { "value": 1 }
      },
      "god_eye:state_alert": {
        "minecraft:mark_variant": { "value": 2 }
      },
      "god_eye:state_execute": {
        "minecraft:mark_variant": { "value": 3 }
      },
      "god_eye:despawn": {
        "minecraft:instant_despawn": {}
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": ["god_eye", "guardian_eye"]
      },
      "minecraft:collision_box": {
        "width": 0.9,
        "height": 0.9
      },
      "minecraft:physics": {
        "has_gravity": false,
        "has_collision": false
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:movement": {
        "value": 0.0
      },
      "minecraft:health": {
        "value": 500,
        "max": 500
      },
      "minecraft:knockback_resistance": {
        "value": 1.0,
        "max": 1.0
      },
      "minecraft:fire_immune": true,

      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "suicide",
            "deals_damage": true
          },
          {
            "cause": "self_destruct",
            "deals_damage": true
          },
          {
            "cause": "all",
            "deals_damage": false
          }
        ]
      },

      "minecraft:persistent": {},
      "minecraft:mark_variant": { "value": 0 },

      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 80.0,
          "max_dropped_ticks": 7,
          "use_motion_prediction_hints": false
        }
      },

      "minecraft:behavior.look_at_entity": {
        "priority": 1,
        "look_distance": 18.0,
        "probability": 1.0,
        "look_time": [2.0, 5.0],
        "angle_of_view_horizontal": 360,
        "angle_of_view_vertical": 360,
        "filters": {
          "any_of": [
            { "test": "is_family", "subject": "other", "value": "monster" },
            { "test": "is_family", "subject": "other", "value": "undead" },
            { "test": "is_family", "subject": "other", "value": "illager" }
          ]
        }
      },
      "minecraft:behavior.look_at_player": {
        "priority": 2,
        "look_distance": 20.0,
        "probability": 0.5,
        "look_time": [2.0, 6.0],
        "angle_of_view_horizontal": 360,
        "angle_of_view_vertical": 360
      },
      "minecraft:behavior.random_look_around": {
        "priority": 5,
        "look_time": [1.0, 4.0]
      }
    },

    "events": {
      "god_eye:set_idle": {
        "remove": {
          "component_groups": [
            "god_eye:state_shy",
            "god_eye:state_alert",
            "god_eye:state_execute"
          ]
        },
        "add": { "component_groups": ["god_eye:state_idle"] }
      },
      "god_eye:set_shy": {
        "remove": {
          "component_groups": [
            "god_eye:state_idle",
            "god_eye:state_alert",
            "god_eye:state_execute"
          ]
        },
        "add": { "component_groups": ["god_eye:state_shy"] }
      },
      "god_eye:set_alert": {
        "remove": {
          "component_groups": [
            "god_eye:state_idle",
            "god_eye:state_shy",
            "god_eye:state_execute"
          ]
        },
        "add": { "component_groups": ["god_eye:state_alert"] }
      },
      "god_eye:set_execute": {
        "remove": {
          "component_groups": [
            "god_eye:state_idle",
            "god_eye:state_shy",
            "god_eye:state_alert"
          ]
        },
        "add": { "component_groups": ["god_eye:state_execute"] }
      },
      "god_eye:vanish": {
        "add": { "component_groups": ["god_eye:despawn"] }
      }
    }
  }
}
