          },
          {
            "cause": "entity_explosion",
            "deals_damage": true,
            "damage_multiplier": 0.25
          }
        ]
      },

      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 500 : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/world_eater.json"
      },
      "minecraft:boss": {
        "should_darken_sky": false,
        "hud_range": 55,
        "name": "World Eater - Stage 1: Hungry"
      },

      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 80,
          "max_dropped_ticks": 10,
          "use_motion_prediction_hints": true
        }
      },

      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "operator": "!=",
              "value": "world_eater"
            }
          }
        ]
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": false,
        "must_reach": false,
        "reselect_targets": true,
        "scan_interval": 20,
        "within_radius": 40,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "operator": "!=",
                  "value": "world_eater"
                },
                {
                  "any_of": [
                    { "test": "is_family", "subject": "other", "value": "player" },
                    { "test": "is_family", "subject": "other", "value": "villager" },
                    { "test": "is_family", "subject": "other", "value": "monster" },
                    { "test": "is_family", "subject": "other", "value": "animal" },
                    { "test": "is_family", "subject": "other", "value": "irongolem" }
                  ]
                }
              ]
            },
            "max_dist": 40
          }
        ]
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "track_target": true,
        "reach_multiplier": 2.4,
        "speed_multiplier": 1.0,
        "attack_once": false
      },
      "minecraft:behavior.move_towards_target": {
        "priority": 4,
        "speed_multiplier": 1.0,
        "within_radius": 40
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8,
        "xz_dist": 14,
        "y_dist": 6
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 24,
        "probability": 0.3
      },
      "minecraft:behavior.random_look_around": { "priority": 8 }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": [ "we:stage_1" ] }
      },
      "we:stage_1": {
        "remove": {
          "component_groups": [ "we:stage_1", "we:stage_2", "we:stage_3", "we:stage_4" ]
        },
        "add": { "component_groups": [ "we:stage_1" ] }
      },
      "we:stage_2": {
        "remove": {
          "component_groups": [ "we:stage_1", "we:stage_2", "we:stage_3", "we:stage_4" ]
        },
        "add": { "component_groups": [ "we:stage_2" ] }
      },
      "we:stage_3": {
        "remove": {
          "component_groups": [ "we:stage_1", "we:stage_2", "we:stage_3", "we:stage_4" ]
        },
        "add": { "component_groups": [ "we:stage_3" ] }
      },
      "we:stage_4": {
        "remove": {
          "component_groups": [ "we:stage_1", "we:stage_2", "we:stage_3", "we:stage_4" ]
        },
        "add": { "component_groups": [ "we:stage_4" ] }
      },
      "we:begin_death": {
        "add": { "component_groups": [ "we:dying" ] }
      },
      "we:end_death": {
        "remove": { "component_groups": [ "we:dying" ] }
      },
      "we:despawn": {
        "add": { "component_groups": [ "we:despawn" ] }
      }
