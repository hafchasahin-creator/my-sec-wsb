    <string name="ob1_title">Record in one tap</string>
    <string name="ob1_body">The big Record button captures whatever is on screen — games, calls, tutorials, anything.</string>
    <string name="ob2_title">Android asks first</string>
    <string name="ob2_body">A system dialog appears every time capture starts. That prompt comes from Android and cannot be skipped by any app.</string>
    <string name="ob3_title">Controls that follow you</string>
    <string name="ob3_body">Turn on floating controls to pause, stop, annotate or grab a screenshot without returning here.</string>
    <string name="ob4_title">Everything is saved</string>
    <string name="ob4_body">Stop from the bubble or the notification. Finished clips appear in your Video library, ready to play or share.</string>

