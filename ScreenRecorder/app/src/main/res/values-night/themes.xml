<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Intentionally identical to the light theme so system dark mode cannot produce a
         half-tuned palette. The app commits to one look. -->
    <style name="Theme.Imran" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_tint</item>
        <item name="colorOnPrimaryContainer">@color/brand_600</item>
        <item name="colorSecondary">@color/brand_end</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOutline">@color/divider</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowAnimationStyle">@style/Anim.Imran</item>
        <item name="materialAlertDialogTheme">@style/Theme.Imran.Dialog</item>
    </style>
</resources>
