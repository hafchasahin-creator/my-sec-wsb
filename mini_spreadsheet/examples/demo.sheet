# The transcript from the brief
SET A1 10
SET A2 20
SET A3 =A1+A2
GET A3
SET A1 50
GET A3

# operator precedence, parentheses, unary minus
SET B1 4
SET B2 =-A1 + 2 * (B1 + 3) / 2
GET B2

# ranges: SUM/AVG ignore blanks, and a blank filled later still propagates
SET C1 1
SET C2 2
SET C4 4
SET D1 =SUM(C1:C20)
SET D2 =AVG(C1:C20)
GET D1
GET D2
SET C3 3
GET D1
GET D2

# errors are values and propagate downstream
SET E1 0
SET E2 =A1/E1
SET E3 =E2+1
GET E3
SET E1 5
GET E3

# a cycle is refused, and the old value survives
SET F1 =A1+1
GET F1
SET F1 =F1+1
GET F1
LIST
